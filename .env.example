# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ADMIN_LOG_CHANNEL_ID=

# FastAPI (API AI + Web Dashboard dalam satu port, buka http://127.0.0.1:8000)
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000

# Database
DATABASE_PATH=app.db

# Moderation Policies
RUN_MODE=all
WARNING_DELETE_AFTER_SECONDS=10
KICK_VIOLATION_THRESHOLD=3
